# Your Base wallet address that will receive USDC payments (required)
PAY_TO_ADDRESS=0xYourWalletAddressHere

# "testnet" for Base Sepolia (free, safe to test with) or "mainnet" for real USDC
X402_NETWORK=testnet

# Price charged per API call
X402_PRICE_USD=$0.01

# Only needed when X402_NETWORK=mainnet (get these from https://portal.cdp.coinbase.com)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
