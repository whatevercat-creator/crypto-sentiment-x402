# Your Base wallet address that will receive USDC payments (required)
PAY_TO_ADDRESS=0xYourWalletAddressHere

# "testnet" for Base Sepolia (free, safe to test with) or "mainnet" for real USDC
X402_NETWORK=testnet

# Price charged per API call
X402_PRICE_USD=$0.01

# Only needed when X402_NETWORK=mainnet (get these from https://portal.cdp.coinbase.com)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Stripe subscription tiers (optional -- the x402 pay-per-call lane above
# works fine without any of this). See BILLING.md for full setup.
# Public base URL of this deployment, used to build Stripe checkout redirects.
APP_BASE_URL=http://localhost:8000

# From your Stripe dashboard (test mode keys while you build this out).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# Where the subscriber/API-key sqlite db lives. Leave as-is for local dev;
# on Render this is set to a path on the mounted persistent disk instead
# (see render.yaml) so it survives redeploys.
BILLING_DB_PATH=billing.db

# --- Sentiment-shift alerts (optional -- bundled into Starter/Pro tiers,
# no separate billing). See ALERTS.md for full setup.
# How often (seconds) the background poller re-checks watched symbols.
ALERT_POLL_INTERVAL_SECONDS=900

# Default |compound score| delta that counts as a "shift" if a watch
# doesn't set its own threshold.
ALERT_THRESHOLD_DEFAULT=0.3

# Only needed if any customer registers a "telegram" channel_type watch.
# Create a bot via @BotFather on Telegram to get this token.
TELEGRAM_BOT_TOKEN=

# --- Historical dataset export (optional -- bundled as its own "data" tier
# in Stripe, $29/mo default). See DATASET.md for full setup.
# Comma-separated symbols to snapshot daily (default: everything in app/coins.py).
SNAPSHOT_SYMBOLS=

# How often (seconds) the snapshot loop wakes up to check whether today's
# reading is still needed. It only ever records one row per symbol per day
# regardless of this value -- this just controls how soon after a restart
# it catches up.
SNAPSHOT_INTERVAL_SECONDS=3600

# Stripe Price ID for the "Data Access" product (see BILLING.md's pattern --
# same Stripe account, same webhook, just one more product/price).
STRIPE_PRICE_ID_DATA=
